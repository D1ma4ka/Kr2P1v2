# Reference only. Use python scripts/init_dev.py for random LOCAL credentials.
# Never commit .env. Required values below intentionally blank; not working secrets.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
DB_POOL_MAX=10
# Host process: relative to backend/. Compose uses its private /data/media volume.
MEDIA_ROOT=../work/media
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
MAILPIT_API_URL=http://127.0.0.1:58025
# Dev CLI is explicit, synthetic only, and refuses to overwrite this file.
DEV_ACCOUNTS_FILE=../work/dev-accounts.json
