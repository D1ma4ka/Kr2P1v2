{
  "name": "@krapiva/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 dist/test/*.test.js",
    "check": "npm run build && npm test",
    "start": "node dist/src/main.js",
    "migrate": "node dist/src/db/migrate.js",
    "openapi": "node dist/src/http/export-openapi.js",
    "dev:accounts": "node dist/src/operations/provision.js",
    "dev:mail": "node dist/src/operations/test-mail.js"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.3",
    "cities-1000-structured": "1.0.1",
    "fastify": "5.12.8",
    "i18n-iso-countries": "7.14.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
